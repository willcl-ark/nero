+// Copyright 2026 The Forgejo Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package githubmetadata
+
+import (
+	"testing"
+	"time"
+
+	"forgejo.org/models/db"
+	issues_model "forgejo.org/models/issues"
+	repo_model "forgejo.org/models/repo"
+	"forgejo.org/models/unittest"
+	user_model "forgejo.org/models/user"
+	"forgejo.org/modules/timeutil"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestMain(m *testing.M) {
+	unittest.MainTest(m)
+}
+
+func TestImportedCommentEdits(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	issue := unittest.AssertExistsAndLoadBean(t, &issues_model.Issue{ID: 1})
+	imp := &importer{repo: &repo_model.Repository{ID: issue.RepoID}}
+	created := time.Unix(1000, 0).UTC()
+	edited := created.Add(time.Hour)
+
+	for _, tc := range []struct {
+		name          string
+		kind          string
+		importComment func(*issues_model.Issue, int64, string, time.Time) error
+	}{
+		{
+			name: "issue comment", kind: sourceKindIssueComment,
+			importComment: func(issue *issues_model.Issue, sourceID int64, body string, updated time.Time) error {
+				return imp.importIssueComments(t.Context(), issue, []githubEvent{{
+					Event: "commented", ID: sourceID, Body: body, CreatedAt: &created, UpdatedAt: &updated,
+				}})
+			},
+		},
+		{
+			name: "review comment", kind: sourceKindReviewComment,
+			importComment: func(issue *issues_model.Issue, sourceID int64, body string, updated time.Time) error {
+				return imp.importReviewComments(t.Context(), issue, 1, []githubReviewComment{{
+					ID: sourceID, Body: body, CreatedAt: created, UpdatedAt: updated,
+				}})
+			},
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			comment := &issues_model.Comment{
+				Type: issues_model.CommentTypeComment, IssueID: issue.ID,
+				PosterID: user_model.GhostUserID, Content: "original",
+				CreatedUnix: timeutil.TimeStamp(created.Unix()),
+				UpdatedUnix: timeutil.TimeStamp(created.Unix()),
+			}
+			_, err := db.GetEngine(t.Context()).NoAutoTime().Insert(comment)
+			require.NoError(t, err)
+			stored, err := issues_model.GetCommentByID(t.Context(), comment.ID)
+			require.NoError(t, err)
+			require.Equal(t, timeutil.TimeStamp(created.Unix()), stored.UpdatedUnix)
+			sourceID := comment.ID + 1000000
+			require.NoError(t, recordSourceMap(t.Context(), issue.RepoID, tc.kind, sourceID, comment.ID, issue.Index))
+
+			require.NoError(t, tc.importComment(issue, sourceID, "edited", edited))
+			got, err := issues_model.GetCommentByID(t.Context(), comment.ID)
+			require.NoError(t, err)
+			require.Equal(t, "edited", got.Content)
+			require.Equal(t, timeutil.TimeStamp(edited.Unix()), got.UpdatedUnix)
+
+			require.NoError(t, tc.importComment(issue, sourceID, "stale", created))
+			got, err = issues_model.GetCommentByID(t.Context(), comment.ID)
+			require.NoError(t, err)
+			require.Equal(t, "edited", got.Content)
+		})
+	}
+}
