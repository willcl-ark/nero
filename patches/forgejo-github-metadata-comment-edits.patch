+func (imp *importer) updateComment(ctx context.Context, id int64, body string, updated time.Time) error {
+	comment, err := issues_model.GetCommentByID(ctx, id)
+	if err != nil {
+		return err
+	}
+	updatedUnix := timeutil.TimeStamp(updated.Unix())
+	if updatedUnix <= comment.UpdatedUnix {
+		return nil
+	}
+	content, err := imp.localizeContentAssets(ctx, body, assetTarget{
+		RepoID:      imp.repo.ID,
+		IssueID:     comment.IssueID,
+		CommentID:   comment.ID,
+		UploaderID:  comment.PosterID,
+		CreatedUnix: int64(comment.CreatedUnix),
+	})
+	if err != nil {
+		return err
+	}
+	comment.Content = content
+	comment.UpdatedUnix = updatedUnix
+	_, err = db.GetEngine(ctx).ID(comment.ID).NoAutoTime().Cols("content", "updated_unix").Update(comment)
+	return err
+}
