+func TestNewReviewCommentHasMappedID(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	issue := unittest.AssertExistsAndLoadBean(t, &issues_model.Issue{ID: 1})
+	imp := &importer{repo: &repo_model.Repository{ID: issue.RepoID}}
+	created := time.Unix(1000, 0).UTC()
+	source := githubReviewComment{
+		ID: 987655, User: &githubUser{Login: "reviewer", ID: 12345},
+		Body: "new comment", Path: "src/example.cpp", CommitID: "abc123",
+		CreatedAt: created, UpdatedAt: created,
+	}
+	pr := &issues_model.PullRequest{Index: issue.Index}
+	require.NoError(t, imp.importSyntheticReview(t.Context(), issue, pr, -source.ID, []githubReviewComment{source}))
+
+	mapping, err := getSourceMap(t.Context(), issue.RepoID, sourceKindReviewComment, source.ID)
+	require.NoError(t, err)
+	require.NotZero(t, mapping.LocalID)
+	got, err := issues_model.GetCommentByID(t.Context(), mapping.LocalID)
+	require.NoError(t, err)
+	require.Equal(t, source.Body, got.Content)
+}
