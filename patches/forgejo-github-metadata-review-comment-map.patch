+func TestReviewCommentWithMissingMappedID(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	issue := unittest.AssertExistsAndLoadBean(t, &issues_model.Issue{ID: 1})
+	imp := &importer{repo: &repo_model.Repository{ID: issue.RepoID}}
+	created := time.Unix(1000, 0).UTC()
+	originalLine := 10
+	source := githubReviewComment{
+		ID: 987654, User: &githubUser{Login: "reviewer", ID: 12345},
+		Body: "original", Path: "src/example.cpp", CommitID: "abc123", OriginalCommitID: "abc123",
+		Line: &originalLine, OriginalLine: &originalLine,
+		CreatedAt: created, UpdatedAt: created,
+	}
+	comment := reviewComment(issue, 1, source)
+	_, err := db.GetEngine(t.Context()).NoAutoTime().Insert(comment)
+	require.NoError(t, err)
+	otherLine := 42
+	otherSource := source
+	otherSource.Line = &otherLine
+	other := reviewComment(issue, 1, otherSource)
+	_, err = db.GetEngine(t.Context()).NoAutoTime().Insert(other)
+	require.NoError(t, err)
+	require.NoError(t, recordSourceMap(t.Context(), issue.RepoID, sourceKindReviewComment, source.ID, 0, issue.Index))
+
+	rebasedLine := 20
+	source.Line = &rebasedLine
+	source.CommitID = "rebased"
+	source.Body = "edited"
+	source.UpdatedAt = created.Add(time.Hour)
+	require.NoError(t, imp.importReviewComments(t.Context(), issue, 1, []githubReviewComment{source}))
+
+	mapping, err := getSourceMap(t.Context(), issue.RepoID, sourceKindReviewComment, source.ID)
+	require.NoError(t, err)
+	require.Equal(t, comment.ID, mapping.LocalID)
+	got, err := issues_model.GetCommentByID(t.Context(), comment.ID)
+	require.NoError(t, err)
+	require.Equal(t, "edited", got.Content)
+	require.Equal(t, timeutil.TimeStamp(source.UpdatedAt.Unix()), got.UpdatedUnix)
+}
