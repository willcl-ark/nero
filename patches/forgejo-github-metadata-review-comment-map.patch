+func findLegacyReviewComment(ctx context.Context, reviewID int64, source githubReviewComment) (*issues_model.Comment, error) {
+	authorID := int64(0)
+	if source.User != nil {
+		authorID = source.User.ID
+	}
+	var candidates []*issues_model.Comment
+	err := db.GetEngine(ctx).
+		Where("review_id = ?", reviewID).
+		And("type = ?", issues_model.CommentTypeCode).
+		And("created_unix = ?", source.CreatedAt.Unix()).
+		And("tree_path = ?", util.PathJoinRel(source.Path)).
+		And("original_author_id = ?", authorID).
+		Find(&candidates)
+	if err != nil {
+		return nil, err
+	}
+	if len(candidates) == 1 {
+		return candidates[0], nil
+	}
+	originalLine := int64PtrValue(source.OriginalLine, source.Line)
+	if source.Side == "LEFT" {
+		originalLine = -originalLine
+	}
+	for _, key := range []struct {
+		line   int64
+		commit string
+	}{
+		{originalLine, firstNonEmpty(source.OriginalCommitID, source.CommitID)},
+		{reviewCommentLine(source), firstNonEmpty(source.CommitID, source.OriginalCommitID)},
+	} {
+		var match *issues_model.Comment
+		for _, candidate := range candidates {
+			if candidate.Line == key.line && candidate.CommitSHA == key.commit {
+				if match != nil {
+					return nil, fmt.Errorf("ambiguous legacy review comment %d in review %d", source.ID, reviewID)
+				}
+				match = candidate
+			}
+		}
+		if match != nil {
+			return match, nil
+		}
+	}
+	return nil, fmt.Errorf("missing legacy review comment %d in review %d", source.ID, reviewID)
+}
