+type pendingPullSync struct {
+	Index   int64  `json:"index"`
+	HeadSHA string `json:"head_sha"`
+}
+
+func enqueuePullSync(pending []pendingPullSync, next pendingPullSync) []pendingPullSync {
+	for i := range pending {
+		if pending[i].Index == next.Index {
+			pending[i] = next
+			return pending
+		}
+	}
+	return append(pending, next)
+}
+
+func readPendingPullSyncs(metadataPath string) ([]pendingPullSync, error) {
+	data, err := os.ReadFile(filepath.Join(metadataPath, pendingPullSyncsFile))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var pending []pendingPullSync
+	if err := json.Unmarshal(data, &pending); err != nil {
+		return nil, fmt.Errorf("read pending pull request notifications: %w", err)
+	}
+	return pending, nil
+}
+
+func writePendingPullSyncs(metadataPath string, pending []pendingPullSync) error {
+	filename := filepath.Join(metadataPath, pendingPullSyncsFile)
+	if len(pending) == 0 {
+		if err := os.Remove(filename); err != nil && !errors.Is(err, os.ErrNotExist) {
+			return err
+		}
+		return nil
+	}
+	sort.Slice(pending, func(i, j int) bool { return pending[i].Index < pending[j].Index })
+	data, err := json.Marshal(pending)
+	if err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(metadataPath, pendingPullSyncsFile+"-*")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	defer os.Remove(tmpName)
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmpName, filename)
+}
+
+func retryPendingPullSyncs(
+	ctx context.Context,
+	repo *repo_model.Repository,
+	pending []pendingPullSync,
+) []pendingPullSync {
+	if len(pending) == 0 {
+		return nil
+	}
+	gitRepo, err := gitrepo.OpenRepository(ctx, repo)
+	if err != nil {
+		log.Warn("Unable to check pending pull request refs for %s: %v", repo.FullName(), err)
+		return pending
+	}
+
+	var ready []*issues_model.PullRequest
+	remaining := make([]pendingPullSync, 0, len(pending))
+	for _, item := range pending {
+		pr, err := issues_model.GetPullRequestByIndex(ctx, repo.ID, item.Index)
+		if err != nil {
+			log.Warn("Unable to load pending pull request %s#%d: %v", repo.FullName(), item.Index, err)
+			remaining = append(remaining, item)
+			continue
+		}
+		if pr.Issue.IsClosed || pr.HasMerged {
+			continue
+		}
+		commitID, err := gitRepo.GetRefCommitID(pr.GetGitRefName())
+		if err != nil || commitID != item.HeadSHA {
+			log.Trace(
+				"Deferring pull request notification for %s#%d until head %s is mirrored",
+				repo.FullName(), item.Index, item.HeadSHA,
+			)
+			remaining = append(remaining, item)
+			continue
+		}
+		ready = append(ready, pr)
+	}
+	gitRepo.Close()
+	for _, pr := range ready {
+		notify_service.PullRequestSynchronized(ctx, user_model.NewGhostUser(), pr)
+	}
+	return remaining
+}
