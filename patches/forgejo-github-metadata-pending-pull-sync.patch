+func TestPendingPullSyncsPersistAndReplaceHead(t *testing.T) {
+	dir := t.TempDir()
+	pending := enqueuePullSync(nil, pendingPullSync{Index: 36378, HeadSHA: "old"})
+	pending = enqueuePullSync(pending, pendingPullSync{Index: 36378, HeadSHA: "new"})
+	pending = enqueuePullSync(pending, pendingPullSync{Index: 36379, HeadSHA: "other"})
+	require.NoError(t, writePendingPullSyncs(dir, pending))
+
+	got, err := readPendingPullSyncs(dir)
+	require.NoError(t, err)
+	require.Equal(t, []pendingPullSync{
+		{Index: 36378, HeadSHA: "new"},
+		{Index: 36379, HeadSHA: "other"},
+	}, got)
+
+	require.NoError(t, writePendingPullSyncs(dir, nil))
+	got, err = readPendingPullSyncs(dir)
+	require.NoError(t, err)
+	require.Empty(t, got)
+}
